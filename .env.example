# Optional Firebase Web App config for Google Sign-In + Google Drive appDataFolder sync.
# Without these values, the app runs cleanly in Guest Mode (IndexedDB only).
# Note: Firebase Web API keys are public client identifiers, not backend secrets.

# Option 1: Single JSON string (also supported as GitHub Actions secret/variable FIREBASE_CONFIG_JSON)
# FIREBASE_CONFIG_JSON='{"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}'

# Option 2: Individual Vite variables
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
