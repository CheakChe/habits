# Optional Google OAuth Client ID for Google Sign-In, Drive appDataFolder sync,
# and Google Calendar reminders via Google Identity Services (GIS).
# Without this config, Guest Mode (local IndexedDB) works completely offline.
# Note: Web OAuth Client IDs are public client identifiers, not backend secrets.

VITE_GOOGLE_OAUTH_CLIENT_ID=""

# Optional Firebase Web App fallback (used only if VITE_GOOGLE_OAUTH_CLIENT_ID is not set):
# FIREBASE_CONFIG_JSON='{"apiKey":"...","authDomain":"...","projectId":"...","appId":"...","oAuthClientId":"..."}'
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
